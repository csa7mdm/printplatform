{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=printplatform;Username=postgres;Password=changeme;Pooling=true;MinPoolSize=2;MaxPoolSize=50",
    "HangfireConnection": "Host=localhost;Port=5432;Database=printplatform_hangfire;Username=postgres;Password=changeme"
  },

  "Jwt": {
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS",
    "Issuer": "PrintPlatform",
    "Audience": "PrintPlatformClients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },

  "Storage": {
    "Provider": "MinIO",
    "BucketName": "printplatform",
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UsePathStyle": true
  },

  "Paymob": {
    "ApiKey": "",
    "IntegrationId": "",
    "IframeId": ""
  },

  "Bosta": {
    "ApiKey": "",
    "BaseUrl": "https://app.bosta.co/api/v2"
  },

  "WhatsApp": {
    "Token": "",
    "PhoneNumberId": ""
  },

  "Gamification": {
    "PointsPerOrder": 10,
    "BonusMultiplier": 1.0,
    "PointsExpiryDays": 0
  },

  "Loyalty": {
    "SilverThreshold": 500,
    "GoldThreshold": 2000,
    "PlatinumThreshold": 5000,
    "CashBackPercent": 5.0
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },

  "Hangfire": {
    "DashboardPath": "/hangfire"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/printplatform-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "AllowedHosts": "*"
}
