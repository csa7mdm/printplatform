# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=Host=localhost;Port=5432;Database=printplatform;Username=postgres;Password=changeme
HANGFIRE_DATABASE_URL=Host=localhost;Port=5432;Database=printplatform_hangfire;Username=postgres;Password=changeme

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-char-random-string
JWT_ISSUER=PrintPlatform
JWT_AUDIENCE=PrintPlatformClients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# ── Storage (MinIO / S3-compatible) ───────────────────────────────────────────
STORAGE_PROVIDER=MinIO
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=printplatform
STORAGE_USE_SSL=false

# ── Paymob ────────────────────────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ── Bosta ─────────────────────────────────────────────────────────────────────
BOSTA_API_KEY=
BOSTA_BASE_URL=https://app.bosta.co/api/v2
BOSTA_WEBHOOK_SECRET=

# ── WhatsApp Business API (Meta Cloud) ────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-random-string-for-webhook-verification

# ── Admin seed account ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@printplatform.eg
ADMIN_PASSWORD=ChangeMeOnFirstLogin!

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8080
